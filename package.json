{
  "name": "crud-veiculos-api",
  "version": "1.0.0",
  "description": "API CRUD de veículos com Vertical Slice e Clean Architecture",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "validate": "npm test && npm run build",
    "precommit": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'powershell .\\\\scripts\\\\pre-commit.ps1' : 'bash scripts/pre-commit.sh', {stdio: 'inherit'})\""
  },
  "keywords": ["nodejs", "typescript", "clean-architecture", "vertical-slice"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.1.1",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "jest-junit": "^16.0.0"
  }
}
